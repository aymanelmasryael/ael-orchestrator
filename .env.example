# ============================================================================
# AEL Orchestrator · Environment Template
# ============================================================================
#
# ⚠️  IMPORTANT: This project does NOT need a .env file to run.
#     API keys are entered directly in the browser UI and stored in
#     sessionStorage only. This file exists as documentation.
#
# ⚠️  NEVER commit a real .env file. It is already in .gitignore.
#
# ============================================================================

# OpenAI
VITE_OPENAI_API_KEY=sk-...your-key-here

# Anthropic
VITE_ANTHROPIC_API_KEY=sk-ant-...your-key-here

# Google AI (Gemini)
VITE_GOOGLE_API_KEY=AIza...your-key-here

# Groq
VITE_GROQ_API_KEY=gsk_...your-key-here